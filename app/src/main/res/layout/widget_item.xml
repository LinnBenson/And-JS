<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_item" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="3dp">
    <ImageView android:id="@+id/widget_card_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <ImageView android:id="@+id/widget_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="9dp" android:importantForAccessibility="no"/>
    <ImageView android:id="@+id/widget_play" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|end" android:layout_marginEnd="10dp" android:layout_marginTop="13dp" android:src="@drawable/ic_play" android:alpha="0.55" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="10dp" android:layout_marginBottom="8dp" android:gravity="start" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</FrameLayout>
